import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        Map<Integer, Integer> freq = new HashMap<>();

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
            freq.put(arr[i], freq.getOrDefault(arr[i], 0) + 1);
        }

        int k = sc.nextInt();

        List<Integer> elements = new ArrayList<>(freq.keySet());

        elements.sort((a, b) -> {
            int cmp = Integer.compare(freq.get(b), freq.get(a));
            return cmp != 0 ? cmp : Integer.compare(a, b);
        });

        for (int i = 0; i < Math.min(k, elements.size()); i++) {
            System.out.print(elements.get(i));
            if (i < Math.min(k, elements.size()) - 1) {
                System.out.print(" ");
            }
        }

        System.out.println();
        sc.close();
    }
}
